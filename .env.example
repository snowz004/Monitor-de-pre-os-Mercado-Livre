# Destinatário do alerta quando o preço cair abaixo do limite
EMAIL_TO=seu@email.com

# Limite em reais (use ponto ou vírgula). Ex.: 2500 ou 2500,99
PRICE_THRESHOLD=2500

# Caminho do Excel (opcional; padrão: consultas_preco.xlsx na pasta do script)
# EXCEL_PATH=consultas_preco.xlsx

# SMTP (ex.: Gmail com senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASSWORD=sua_senha_de_app
EMAIL_FROM=seu@gmail.com
